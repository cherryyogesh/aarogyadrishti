# =====================================================================
# Aarogya Drishti & Aarogya Mytra AI — Environment Configuration Template
# =====================================================================
# Copy this file to backend/.env and provide your secrets.
# NEVER commit .env to version control.

# 1. PRIMARY AI ENGINE: GOOGLE GEMINI API
# ---------------------------------------------------------------------
# Obtain a Google Gemini API Key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=3

# Optional Secondary Providers
GROQ_API_KEY=
OPENAI_API_KEY=

# 2. APPLICATION SETTINGS
# ---------------------------------------------------------------------
ENVIRONMENT=development
SECRET_KEY=generate_a_secure_random_secret_key_for_production
DATABASE_URL=sqlite:///./aarogya_drishti.db

# 3. REAL SMS & OTP GATEWAY SETTINGS
# ---------------------------------------------------------------------
SMS_PROVIDER=auto
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
FAST2SMS_API_KEY=
MSG91_AUTH_KEY=
MSG91_SENDER_ID=AARDRI
MSG91_TEMPLATE_ID=
DLT_API_KEY=
DLT_SENDER_ID=AARDRI
DLT_ENTITY_ID=

# 4. WEBRTC TELEMEDICINE
# ---------------------------------------------------------------------
STUN_SERVER_URL=stun:stun.l.google.com:19302
TURN_SERVER_URL=
TURN_SERVER_CREDENTIALS=

